# Server Configuration
PORT=5000

# MongoDB Connection (Replace with your actual MongoDB Atlas connection string)
# Format: mongodb+srv://username:password@cluster.mongodb.net/ankitacademy
MONGODB_URI=mongodb://127.0.0.1:27017/ankitacademy

# JWT Configuration
# Generate a secure secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRE=7d

# Frontend URL (Update this for production)
# For local development: http://localhost:5173
# For production: https://your-project.vercel.app
FRONTEND_URL=http://localhost:5173

# Node Environment
NODE_ENV=development

