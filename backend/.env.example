# Ankit Academy - Environment Configuration Template
# Copy this file to .env and update with your values

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/ankitacademy

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_key
JWT_EXPIRE=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File Upload Configuration
MAX_FILE_SIZE=100000000
UPLOAD_PATH=./uploads

# AI Service (Optional - uses local fallback if not set)
# Get your free API key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# API Referer for OpenRouter
API_REFERER=http://localhost:5173
