### Backend Environment Variables
# Copy to .env (gitignored) for local dev  
# Set in Vercel/Heroku/etc Dashboard for production

# Required
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ankitacademy
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
FRONTEND_URL=http://localhost:5173

# Production
# MONGODB_URI=mongodb+srv://...
# FRONTEND_URL=https://frontend-nu-virid-37.vercel.app

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Payment (future)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-secret
